# Copy to .env (local) and set the same values in Vercel. Never commit .env.
# `npm run secrets` fills the three values marked (generated) without printing them.

# App
# e.g. https://aangan-agent.vercel.app (for webhook URLs)
PUBLIC_BASE_URL=

# Vaani Labs (voice)
# (generated) goes in the webhook URL you give Vaani: https://<app>/api/call-ended?key=<this>
VAANI_WEBHOOK_SECRET=
# your Vaani rate, for the cost figures
VAANI_INR_PER_MIN=
# (generated) only used if Vaani supports mid-call functions
CHECK_LEAD_SECRET=

# Gemini (extraction only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
LLM_INR_PER_MTOK_IN=0
LLM_INR_PER_MTOK_OUT=0

# Supabase (system of record) — service-role key, server only
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HubSpot (CRM) — service key; run `npm run hubspot:setup` to get the IDs below (IDs are not secret)
HUBSPOT_SERVICE_KEY=
HUBSPOT_PORTAL_ID=
HUBSPOT_PIPELINE_ID=
HUBSPOT_STAGE_QUALIFIED=
HUBSPOT_STAGE_REVIEW=
HUBSPOT_STAGE_BOOKED=
HUBSPOT_STAGE_DECLINED=

# Calendly (scheduling) — run `npm run calendly:setup` to list event types and create the webhook
# personal access token
CALENDLY_TOKEN=
# scheduling URL of the consultation event type
CALENDLY_EVENT_URL_RESIDENTIAL=
# optional: separate event type for offices
CALENDLY_EVENT_URL_COMMERCIAL=
# (generated)
CALENDLY_WEBHOOK_SIGNING_KEY=
# true only after `npm run calendly:setup` creates the webhook (paid plan). false = links work, booking status is manual.
CALENDLY_WEBHOOKS_ENABLED=false
# user (default) or organization: use organization when the booking page is a round-robin TEAM event (Teams plan)
CALENDLY_WEBHOOK_SCOPE=user

# Telegram (handoff)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DESIGNERS_CHAT_ID=
TELEGRAM_NIKHIL_CHAT_ID=

# Weekly digest cron (generated): Vercel sends it as a Bearer token; the digest endpoint rejects anything else
CRON_SECRET=

# Dashboard
# (generated)

# Automatic booking link to the caller, right after a qualified call (all optional; leave empty to keep it manual).
# SMS through Twilio. Indian numbers also need a registered sender ID / template with the provider.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Email through Resend (the domain of MAIL_FROM must be verified, or it can only reach your own address).
RESEND_API_KEY=
MAIL_FROM=Aangan Studio <hello@yourdomain.com>
# A copy of every booking link that goes out, to the studio's own address (optional).
LINK_COPY_TO=
